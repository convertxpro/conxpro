# ==============================================================================
# ApexTools - Environment Variables
# ==============================================================================

# Supabase (PostgreSQL Database & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# App Configuration & Canonical URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://apextools.app

# Redis & Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...
IP_HASH_SALT=apextools_secure_pkt_salt_2026

# GitHub Integration & Deployment PAT
GITHUB_TOKEN=ghp_your_classic_token_here

# Ad Networks (Adsterra & Google AdSense)
NEXT_PUBLIC_AD_NETWORK=adsterra
NEXT_PUBLIC_ADSTERRA_PUBLISHER_ID=your_adsterra_publisher_id
NEXT_PUBLIC_ADSTERRA_BANNER_728x90_KEY=your_728x90_banner_key
NEXT_PUBLIC_ADSTERRA_BANNER_300x250_KEY=your_300x250_banner_key
NEXT_PUBLIC_ADSTERRA_NATIVE_KEY=your_native_key
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_URL=//pl...highratecpm.com/.../invoke.js
NEXT_PUBLIC_ADSTERRA_POPUNDER_URL=//pl...highperformanceformat.com/.../invoke.js

NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-your-client-id
